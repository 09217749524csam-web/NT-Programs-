
clc;
clear;

% Input
a = input('Enter the first integer a: ');
b = input('Enter the second integer b: ');
c = input('Enter the value of c in ax + by = c: ');

%% Euclidean Algorithm
A = abs(a);
B = abs(b);

while B ~= 0
    r = mod(A, B);
    A = B;
    B = r;
end

d = A;

fprintf('\nGCD using Euclidean Algorithm = %d\n', d);

%% Extended Euclidean Algorithm
A = abs(a);
B = abs(b);

% Initial coefficients
old_r = A;
r = B;

old_s = 1;
s = 0;

old_t = 0;
t = 1;

while r ~= 0
    q = floor(old_r / r);

    % Update remainders
    temp = old_r - q * r;
    old_r = r;
    r = temp;

    % Update coefficient s
    temp = old_s - q * s;
    old_s = s;
    s = temp;

    % Update coefficient t
    temp = old_t - q * t;
    old_t = t;
    t = temp;
end

% Correct signs according to original a and b
x0 = old_s * sign(a);
y0 = old_t * sign(b);

fprintf('GCD using Extended Euclidean Algorithm = %d\n', old_r);

fprintf('Bezout coefficients:\n');
fprintf('x = %d, y = %d\n', x0, y0);

fprintf('Verification: %d(%d) + %d(%d) = %d\n', ...
    a, x0, b, y0, a*x0 + b*y0);

%% Linear Diophantine Equation

if mod(c, d) == 0
    k = c / d;

    x = x0 * k;
    y = y0 * k;

    fprintf('\nThe equation %dx + %dy = %d has integer solutions.\n', ...
        a, b, c);

    fprintf('One particular solution is:\n');
    fprintf('x = %d, y = %d\n', x, y);

    fprintf('Verification:\n');
    fprintf('%d(%d) + %d(%d) = %d\n', ...
        a, x, b, y, a*x + b*y);

    fprintf('\nGeneral solution:\n');
    fprintf('x = %d + (%d)t\n', x, b/d);
    fprintf('y = %d - (%d)t\n', y, a/d);

    fprintf('where t is any integer.\n');

else
    fprintf('\nNo integer solution exists.\n');

    fprintf('Because gcd(%d,%d) = %d does not divide %d.\n', ...
        a, b, d, c);
end
